pipeline {
  agent any

  environment {
    EC2_USER_HOST = 'ubuntu@13.232.74.144'
    SITE_URL = 'https://envision.webcluesstaging.com/'
  }

  stages {
    stage('Run only on versioninfo branch') {
      when {
        expression {
          return env.BRANCH_NAME == 'versioninfo' || env.GIT_BRANCH == 'origin/versioninfo'
        }
      }
      stages {
        stage('Checkout Code') {
          steps {
            checkout scm
          }
        }

        stage('Run Deployment Script on Staging EC2') {
          steps {
            sshagent(credentials: ['envision-ssh-key']) {
              sh '''
                # Export Jenkins env variables for remote use
                export PR_NUMBER="${CHANGE_ID:-}"
                export BUILD_NUMBER="${BUILD_NUMBER}"
                export BRANCH_NAME="${BRANCH_NAME}"
                export GIT_COMMIT="${GIT_COMMIT}"

                # Run deploy script on EC2
                ssh -o StrictHostKeyChecking=no $EC2_USER_HOST "bash /home/ubuntu/scripts/test-frontend-deploy.sh"
              '''
            }
          }
        }
      }
    }
  }
}
