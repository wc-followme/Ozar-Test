pipeline {
  agent any

  environment {
    SITE_URL_QA = 'https://envision.webcluesstaging.com/'
    EC2_USER_HOST_QA = 'ubuntu@13.232.74.144'
    SITE_URL_MASTER = 'https://virtualhomes.webcluesstaging.com/'
    EC2_USER_HOST_MASTER = 'ubuntu@54.162.24.149'
  }

  stages {
    stage('QA Branch Deploy') {
      when {
        expression {
          return env.BRANCH_NAME == 'qa' || env.GIT_BRANCH == 'origin/qa'
        }
      }
      stages {
        stage('Checkout Code') {
          steps {
            checkout scm
          }
        }

        stage('Run Deployment Script on QA EC2') {
          steps {
            script {
              def branchName = env.GIT_BRANCH ? env.GIT_BRANCH.replaceAll(/^origin\//, '') : (env.BRANCH_NAME ?: 'unknown')
              def prNumber = env.CHANGE_ID ?: ''
              sshagent(credentials: ['envision-ssh-key']) {
                sh """
                  ssh -o StrictHostKeyChecking=no $EC2_USER_HOST_QA "
                    export BUILD_NUMBER='${BUILD_NUMBER}' &&
                    export BRANCH_NAME='${branchName}' &&
                    export GIT_COMMIT='${GIT_COMMIT}' &&
                    export PR_NUMBER='${prNumber}' &&
                    bash /home/ubuntu/scripts/frontend-deploy.sh
                  "
                """
              }
            }
          }
        }
      }
    }

    stage('Master Branch Deploy') {
      when {
        expression {
          return env.BRANCH_NAME == 'master' || env.GIT_BRANCH == 'origin/master'
        }
      }
      stages {
        stage('Checkout Code') {
          steps {
            checkout scm
          }
        }

        stage('Run Deployment Script on Master EC2') {
          steps {
            script {
              def branchName = env.GIT_BRANCH ? env.GIT_BRANCH.replaceAll(/^origin\//, '') : (env.BRANCH_NAME ?: 'unknown')
              def prNumber = env.CHANGE_ID ?: ''
              sshagent(credentials: ['envision-ssh-key']) {
                sh """
                  ssh -o StrictHostKeyChecking=no $EC2_USER_HOST_MASTER "
                    export BUILD_NUMBER='${BUILD_NUMBER}' &&
                    export BRANCH_NAME='${branchName}' &&
                    export GIT_COMMIT='${GIT_COMMIT}' &&
                    export PR_NUMBER='${prNumber}' &&
                    bash /home/ubuntu/scripts/frontend-deploy.sh
                  "
                """
              }
            }
          }
        }
      }
    }
  }

  post {
    always {
      script {
        def isQA = env.BRANCH_NAME == 'qa' || env.GIT_BRANCH == 'origin/qa'
        def isMaster = env.BRANCH_NAME == 'master' || env.GIT_BRANCH == 'origin/master'
        if (isQA || isMaster) {
          def color = ['SUCCESS': 'good', 'FAILURE': 'danger', 'UNSTABLE': 'warning'][currentBuild.result] ?: 'warning'
          def siteUrl = isQA ? SITE_URL_QA : SITE_URL_MASTER

          slackSend(
            channel: 'proj-envision',
            message: "Build: *${currentBuild.result}:* JOB ${env.JOB_NAME} build ${env.BUILD_NUMBER} \nMore info at: ${env.BUILD_URL} \nWeb-Site URL: ${siteUrl}",
            color: color
          )

          emailext(
            subject: "Build Result: ${JOB_NAME}-Build# ${BUILD_NUMBER} ${currentBuild.result}",
            body: "${currentBuild.result}: ${BUILD_URL}",
            attachLog: true,
            compressLog: true,
            replyTo: 'harsh.solanki@codezeros.com',
            to: 'harsh.solanki@codezeros.com'
          )
        }
      }
    }
  }
}
